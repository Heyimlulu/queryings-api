# Server
PORT=8080

# CORS (comma-separated list of allowed origins, e.g. https://queryings.com)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4000

# Admin credentials for /v1 and /graphql endpoints
# Option 1 (recommended): bcrypt hash of a strong password (>= 8 chars, letters + numbers)
ADMIN_USERNAME=qryAdmin
ADMIN_PASSWORD_HASH=$2a$10$replaceThisWithYourBcryptHash

# Option 2 (dev only): plain password will be hashed at startup if ADMIN_PASSWORD_HASH is not set.
# Must be >= 8 characters and contain both letters and numbers.
# ADMIN_PASSWORD=ChangeMe123
